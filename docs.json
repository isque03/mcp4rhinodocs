        "pages": [
          "howto/connect-claude",
          "howto/connect-cursor",
          "howto/troubleshoot",
          "howto/report-issues",
          "howto/install-from-source",
          "howto/hot-reload"
        ]
      },
      {
        "group": "Reference",
        "icon": "book",
        "pages": [
          "reference/commands",
          "reference/configuration",
          "reference/mcp-tools"
        ]
      },
      {
        "group": "Explanation",
        "icon": "lightbulb",
        "pages": ["explanation/architecture"]
      }
    ]
